{
  "manifest_version": 3,
  "name": "Lyriq",
  "version": "1.0.0",
  "description": "Synced lyrics overlay for YouTube Music — glass mini player with playback controls.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lrclib.net/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lyriq",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://music.youtube.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content/ytm.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
